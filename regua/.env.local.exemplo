# Copie para .env.local (que fica fora do git) e preencha.

# Cifra do token da Meta. Frase longa e aleatória. SEM ELA a conexão falha
# de propósito: guardar token de conta de anúncios em claro seria falha séria.
REGUA_SECRET=

# App do Meta for Developers. Em modo de desenvolvimento já funciona na SUA
# conta de anúncios, antes do App Review sair.
META_APP_ID=
META_APP_SECRET=

# Precisa bater exatamente com a URI cadastrada no app da Meta.
META_REDIRECT_URI=http://localhost:3100/api/meta/callback

# Opcional: versão da Graph API. Tudo anterior a v24.0 foi depreciado em
# 9 de junho de 2026.
META_API_VERSION=v25.0

# Segredo da sincronização diária. Sem ele a rota /api/meta/cron responde 404
# e o sync automático simplesmente nunca roda — em silêncio.
REGUA_CRON_SECRET=
